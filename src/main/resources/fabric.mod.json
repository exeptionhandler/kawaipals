{
  "schemaVersion": 1,
  "id": "kawaipals",
  "version": "${version}",
  "name": "KawaiPals",
  "description": "Collect adorable magical companions called Pals, each granting unique powers. Catch them, summon them, and discover all 12 in the Compendium!",
  "authors": [
    "KawaiPals Dev Team"
  ],
  "contact": {
    "homepage": "https://github.com/kawaipals/kawaipals-mod",
    "sources": "https://github.com/kawaipals/kawaipals-mod"
  },
  "license": "MIT",
  "icon": "assets/kawaipals/icon.png",

  "environment": "*",

  "entrypoints": {
    "main": [
      "com.kawaipals.KawaiPalsMod"
    ],
    "client": [
      "com.kawaipals.KawaiPalsClient"
    ]
  },

  "mixins": [],

  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api":   "*",
    "minecraft":    "~26.2",
    "java":         ">=25"
  },

  "suggests": {
    "geckolib": "*"
  }
}
